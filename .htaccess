# CONVISITA - protecao basica para hospedagem Apache (cPanel/HostGator)
Options -Indexes
DirectoryIndex index.php

# Arquivos que nao devem ser abertos pelo navegador
<FilesMatch "(^config\.php$|\.(sql|py|md|json|xlsx)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# Front controller: tudo que nao for arquivo/pasta real vai para index-fc.php
# (na Task 11, com as paginas antigas removidas, passa a ser index.php)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index-fc.php [L]
</IfModule>
